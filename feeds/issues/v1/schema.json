{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LeiterConsulting/splunk-version-value-explorer/main/feeds/issues/v1/schema.json",
  "title": "VersionCompass public issue feed 1.0.0",
  "description": "Repository publication of bounded public issue observations. Additional properties are preserved; this schema does not establish product facts or close downstream work. Producer relational and append-only invariants are enforced by sync-issue-feed.cjs.",
  "$defs": {
    "scope": {
      "type": "object",
      "required": [
        "products",
        "versions",
        "editions",
        "deployments",
        "regions",
        "audiences",
        "exclusions"
      ],
      "properties": {
        "products": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "versions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "editions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "deployments": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "regions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "audiences": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "documentRevision": {
      "type": "object",
      "required": [
        "type",
        "value",
        "qualification"
      ],
      "properties": {
        "type": {
          "enum": [
            "sha256",
            "unavailable"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "sha256"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidenceId",
        "url",
        "section",
        "statement",
        "excerpt",
        "role",
        "sourceCheckedAt",
        "availability",
        "documentRevision"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,99}$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "observed",
            "challenging",
            "context"
          ]
        },
        "sourceCheckedAt": {
          "anyOf": [
            {
              "type": "string",
              "anyOf": [
                {
                  "format": "date"
                },
                {
                  "format": "date-time"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "enum": [
            "retrieved",
            "unavailable",
            "not-recorded"
          ]
        },
        "documentRevision": {
          "$ref": "#/$defs/documentRevision"
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "basis",
        "url",
        "pointer",
        "originalLabel"
      ],
      "properties": {
        "basis": {
          "enum": [
            "published-audit-normalization",
            "direct-public-review",
            "synthetic-example"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "pointer": {
          "type": "string",
          "minLength": 1
        },
        "originalLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "synthetic",
        "findingId",
        "revision",
        "recordedAt",
        "evidence",
        "provenance",
        "title",
        "concernType",
        "problem",
        "scope",
        "impact",
        "confidence",
        "claimIds",
        "lifecycle",
        "relationships"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "finding"
        },
        "synthetic": {
          "type": "boolean"
        },
        "findingId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,99}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "recordedAt": {
          "type": "string",
          "anyOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "concernType": {
          "enum": [
            "contradiction",
            "suspected-error",
            "uncertain-claim",
            "coverage-gap"
          ]
        },
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "impact": {
          "type": "object",
          "required": [
            "customerScenario",
            "consequence",
            "level"
          ],
          "properties": {
            "customerScenario": {
              "type": "string",
              "minLength": 1
            },
            "consequence": {
              "type": "string",
              "minLength": 1
            },
            "level": {
              "enum": [
                "unknown",
                "low",
                "moderate",
                "high"
              ]
            }
          },
          "additionalProperties": true
        },
        "confidence": {
          "type": "object",
          "required": [
            "level",
            "rationale"
          ],
          "properties": {
            "level": {
              "enum": [
                "not-rated",
                "low",
                "moderate",
                "high"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "claimIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lifecycle": {
          "type": "object",
          "required": [
            "disposition",
            "reason"
          ],
          "properties": {
            "disposition": {
              "enum": [
                "active",
                "withdrawn",
                "superseded",
                "merged"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "relationships": {
          "type": "object",
          "required": [
            "related",
            "mergedInto",
            "supersedes",
            "supersededBy"
          ],
          "properties": {
            "related": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "mergedInto": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "supersedes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "supersededBy": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": true
        },
        "scopeComparison": {
          "type": "string",
          "minLength": 1
        },
        "coverageSearch": {
          "type": "object",
          "required": [
            "question",
            "expectedAnswer",
            "corpusEvidenceIds",
            "searchedAt",
            "limits"
          ],
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1
            },
            "expectedAnswer": {
              "type": "string",
              "minLength": 1
            },
            "corpusEvidenceIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "searchedAt": {
              "type": "string",
              "anyOf": [
                {
                  "format": "date"
                },
                {
                  "format": "date-time"
                }
              ]
            },
            "limits": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "concernType": {
                "const": "contradiction"
              }
            }
          },
          "then": {
            "required": [
              "scopeComparison"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "concernType": {
                "const": "coverage-gap"
              }
            }
          },
          "then": {
            "required": [
              "coverageSearch"
            ]
          }
        }
      ]
    },
    "assessment": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "synthetic",
        "findingId",
        "revision",
        "recordedAt",
        "evidence",
        "provenance",
        "assessmentId",
        "assessedAt",
        "outcome",
        "rationale",
        "reviewedScope",
        "comparedAssessmentIds",
        "remainingConcerns"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "assessment"
        },
        "synthetic": {
          "type": "boolean"
        },
        "findingId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,99}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "recordedAt": {
          "type": "string",
          "anyOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/provenance"
          }
        },
        "assessmentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,99}$"
        },
        "assessedAt": {
          "anyOf": [
            {
              "type": "string",
              "anyOf": [
                {
                  "format": "date"
                },
                {
                  "format": "date-time"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "still-present",
            "partially-addressed",
            "addressed-in-reviewed-scope",
            "unable-to-verify",
            "not-reassessed"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "reviewedScope": {
          "$ref": "#/$defs/scope"
        },
        "comparedAssessmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "remainingConcerns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "required": [
        "mode",
        "watchFamilies",
        "completeness",
        "exclusions",
        "evidenceThrough"
      ],
      "properties": {
        "mode": {
          "const": "bounded-pilot"
        },
        "watchFamilies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "completeness": {
          "type": "string",
          "minLength": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceThrough": {
          "type": "string",
          "anyOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "recordDescriptor": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "revision",
        "path",
        "sha256",
        "byteLength"
      ],
      "properties": {
        "kind": {
          "enum": [
            "finding",
            "assessment"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,99}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "pattern": "^records/[a-f0-9]{64}\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      },
      "additionalProperties": true
    },
    "publicationDescriptor": {
      "type": "object",
      "required": [
        "publicationId",
        "sequence",
        "publishedAt",
        "path",
        "sha256",
        "byteLength"
      ],
      "properties": {
        "publicationId": {
          "type": "string",
          "pattern": "^vci-[a-f0-9]{64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "publishedAt": {
          "type": "string",
          "anyOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^snapshots/[a-f0-9]{64}\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      },
      "additionalProperties": true
    },
    "snapshot": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "synthetic",
        "sequence",
        "publishedAt",
        "previousPublicationId",
        "coverage",
        "records"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "snapshot"
        },
        "synthetic": {
          "type": "boolean"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "publishedAt": {
          "type": "string",
          "anyOf": [
            {
              "format": "date"
            },
            {
              "format": "date-time"
            }
          ]
        },
        "previousPublicationId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^vci-[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "records": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/recordDescriptor"
          }
        }
      },
      "additionalProperties": true
    },
    "index": {
      "type": "object",
      "required": [
        "schemaVersion",
        "publicationVersion",
        "kind",
        "feedId",
        "synthetic",
        "latest",
        "publications",
        "cadence",
        "repositoryPublication",
        "liveSiteDelivery"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "publicationVersion": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "index"
        },
        "feedId": {
          "enum": [
            "versioncompass-issues",
            "versioncompass-issues-examples"
          ]
        },
        "synthetic": {
          "type": "boolean"
        },
        "latest": {
          "$ref": "#/$defs/publicationDescriptor"
        },
        "publications": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/publicationDescriptor"
          }
        },
        "cadence": {
          "type": "object",
          "required": [
            "mode",
            "fixedFeedInterval",
            "qualification"
          ],
          "properties": {
            "mode": {
              "const": "existing-watch-publications"
            },
            "fixedFeedInterval": {
              "type": "null"
            },
            "qualification": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "repositoryPublication": {
          "type": "object",
          "required": [
            "transport",
            "qualification"
          ],
          "properties": {
            "transport": {
              "const": "commit-pinned-static-json"
            },
            "qualification": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "liveSiteDelivery": {
          "type": "object",
          "required": [
            "status",
            "endpoint",
            "qualification"
          ],
          "properties": {
            "status": {
              "const": "not-designated"
            },
            "endpoint": {
              "type": "null"
            },
            "qualification": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "producer": {
          "$ref": "#/$defs/producer"
        }
      },
      "additionalProperties": true
    },
    "producer": {
      "type": "object",
      "required": [
        "mode",
        "enabled",
        "activatedAt",
        "contractVersion",
        "policy",
        "qualification"
      ],
      "properties": {
        "mode": {
          "const": "native"
        },
        "enabled": {
          "const": true
        },
        "activatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "contractVersion": {
          "const": "1.0.0"
        },
        "policy": {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "byteLength"
          ],
          "properties": {
            "path": {
              "const": "producer-policy.json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byteLength": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/finding"
    },
    {
      "$ref": "#/$defs/assessment"
    },
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/index"
    }
  ]
}
